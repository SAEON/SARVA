map $http_upgrade $preview_connection { default upgrade; '' close; }
server {
    listen 80;
    server_name _;
    absolute_redirect off;
    client_max_body_size 10m;
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Content-Type-Options nosniff always;

    location = /__preview/check {
        internal;
        proxy_pass http://preview-auth:8080/__preview/check;
        proxy_pass_request_body off;
        proxy_method GET;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
    }
    location = /__preview/login {
        client_max_body_size 2k;
        proxy_pass http://preview-auth:8080;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Cookie $http_cookie;
    }
    location = /__preview/logout {
        proxy_pass http://preview-auth:8080;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Cookie $http_cookie;
    }
    location = /__preview/status { proxy_pass http://preview-auth:8080; }
    location = /__preview/login.css { proxy_pass http://preview-auth:8080; }
    location = /__preview/logo.png { proxy_pass http://preview-auth:8080; }
    location = /__preview/hero.jpg { proxy_pass http://preview-auth:8080; }
    location /__preview/ { return 404; }

    location / {
        auth_request /__preview/check;
        error_page 401 = @preview_login;
        proxy_pass ${SARVA_PREVIEW_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $preview_connection;
        proxy_read_timeout 300s;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "private, no-store" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
    }
    location @preview_login {
        default_type application/json;
        add_header Cache-Control no-store always;
        if ($http_accept ~* "text/html") { return 303 /__preview/login; }
        return 401 '{"message":"Preview login required"}';
    }
}
